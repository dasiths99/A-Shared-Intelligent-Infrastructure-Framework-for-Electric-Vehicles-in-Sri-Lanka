# Data is never committed (each component keeps it in <component>/data/)
**/data/raw/**
**/data/interim/**
**/data/processed/**
!**/data/**/.gitkeep
scripts/download_log*.csv

# Databases (contain user / run data - rebuilt by the seed scripts)
*/database/*.db
*/database/*.db-journal

# Frontends
node_modules/
*/frontend/dist/

# Model results that contain large files stay local (configs + metrics JSON are fine to commit)
*/results/*.parquet

# Archives (packed copies of data / environments - too big for GitHub, contain raw data)
*.rar
*.7z
*.zip
*.tar.gz

# Nested, unrelated git repository
csp 002/

# Secrets
.env
.env.*
*.key

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
