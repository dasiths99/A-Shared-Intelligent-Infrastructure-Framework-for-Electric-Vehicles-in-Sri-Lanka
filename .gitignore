# Raw + interim data are NOT committed (8 GB, dataset licences) - share via Drive, see README.
# Processed (cleaned, training-ready) data IS committed (private repo, team decision 2026-10-22).
**/data/raw/**
**/data/interim/**
!**/data/**/.gitkeep
scripts/download_log*.csv

# Databases: c2.db / c3.db / c1_seed.db are committed. c1.db holds real user accounts -> never committed.
charging_scheduling/database/c1.db
*/database/*.db-journal

# Frontends
node_modules/
*/frontend/dist/

# Model results that contain large files stay local (configs + metrics JSON are fine to commit)
*/results/*.parquet

# Archives (packed copies of data / environments - too big for GitHub, contain raw data)
*.rar
*.7z
*.zip
*.tar.gz

# Nested, unrelated git repository
csp 002/

# Secrets
.env
.env.*
*.key

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
